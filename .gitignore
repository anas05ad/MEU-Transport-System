# ─── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Build outputs ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
web-build/

# ─── Expo ───────────────────────────────────────────────────────────────────────
.expo/
expo-env.d.ts
*.orig.*

# ─── Environment variables (contain secrets) ────────────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example — it is safe to commit (no real secrets)

# ─── Native build artefacts ─────────────────────────────────────────────────────
/ios/
/android/
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ─── Editor & OS ────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── TypeScript ─────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Archives (never commit large binaries) ─────────────────────────────────────
*.rar
*.zip
*.tar.gz
*.7z

# ─── Metro bundler ──────────────────────────────────────────────────────────────
.metro-health-check*
